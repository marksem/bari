:_Andy rdf:type owl:NamedIndividual ,
                <https://w3id.org/semanticarts/ns/ontology/gist/Person> ;
       :hasBiologicalFather :_Bob ;
       :hasBiologicalMother :_Betty ,
                            :_Elizabeth .


