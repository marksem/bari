@prefix : <http://semanticarts.com/ont/bari/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://semanticarts.com/ont/bari/> .

<http://semanticarts.com/ont/bari> rdf:type owl:Ontology ;
                                    owl:versionIRI <http://semanticarts.com/ont/bari0.1.0> ;
                                    owl:imports <https://w3id.org/semanticarts/ontology/gistCore14.1.0> ;
                                    rdfs:comment "ISWC Tutorial" .

#################################################################
#    Object Properties
#################################################################

###  http://semanticarts.com/ont/bari/biologicalFatherOf
:biologicalFatherOf rdf:type owl:ObjectProperty ;
                    owl:inverseOf :hasBiologicalFather .


###  http://semanticarts.com/ont/bari/buys
:buys rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf <https://w3id.org/semanticarts/ns/ontology/gist/owns> ;
      rdfs:domain <https://w3id.org/semanticarts/ns/ontology/gist/Person> ;
      rdfs:range :Dog .


###  http://semanticarts.com/ont/bari/hasAncestor
:hasAncestor rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty .


###  http://semanticarts.com/ont/bari/hasBiologicalFather
:hasBiologicalFather rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent> ;
                     rdf:type owl:FunctionalProperty .


###  http://semanticarts.com/ont/bari/hasBiologicalMother
:hasBiologicalMother rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent> ;
                     rdf:type owl:FunctionalProperty .


###  https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent
<https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent> rdfs:subPropertyOf :hasAncestor .


#################################################################
#    Classes
#################################################################

###  http://semanticarts.com/ont/bari/Dog
:Dog rdf:type owl:Class ;
     rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/LivingThing> .


###  http://semanticarts.com/ont/bari/DogOrPerson
:DogOrPerson rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:unionOf ( :Dog
                                                 <https://w3id.org/semanticarts/ns/ontology/gist/Person>
                                               )
                                 ] .


###  http://semanticarts.com/ont/bari/Ethnicity
:Ethnicity rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> .


###  http://semanticarts.com/ont/bari/HasNativeAmericanAncestry
:HasNativeAmericanAncestry rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( <https://w3id.org/semanticarts/ns/ontology/gist/Person>
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :hasAncestor ;
                                                                        owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty <https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy> ;
                                                                                             owl:hasValue :_Ethnicity_NativeAmerican
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] .


###  http://semanticarts.com/ont/bari/HumanBiologicalFather
:HumanBiologicalFather rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( <https://w3id.org/semanticarts/ns/ontology/gist/Person>
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :biologicalFatherOf ;
                                                                    owl:someValuesFrom <https://w3id.org/semanticarts/ns/ontology/gist/Person>
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] .


